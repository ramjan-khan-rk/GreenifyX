PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated browser origins. Native mobile clients send no Origin.
CORS_ORIGIN=

# Optional SMS adapter name. Leave empty until a real provider is wired.
SMS_PROVIDER=

# Non-production only. When true, send-otp may include devOtp in the JSON body.
ALLOW_DEV_OTP=false
