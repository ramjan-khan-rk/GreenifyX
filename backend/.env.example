PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated browser origins. Native mobile clients send no Origin.
CORS_ORIGIN=

# Email OTP. Prefer Brevo. Use a from-address you verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
APP_NAME=GreenifyX

# Optional leftover fallback if BREVO_API_KEY is empty.
RESEND_API_KEY=

# Non-production only. When true, send-otp may include devOtp in the JSON body.
# Ignored when NODE_ENV=production.
ALLOW_DEV_OTP=false

# Optional: enables the AI assistant, Snap & Sort photo recognition and AI-written admin reports.
# Without it, the same features run from live GreenifyX data and templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: TURN relay so voice/video calls connect on mobile data (e.g. a managed TURN service).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Push notifications (FCM). Paste the Firebase service-account JSON on ONE line in Render only. Never commit it.
FIREBASE_SERVICE_ACCOUNT=

# Paid partner rewards (Stripe Checkout). Use sk_test_... while testing.
STRIPE_SECRET_KEY=
# Where Stripe sends people back after paying (the public site)
PUBLIC_SITE_URL=https://greenifyx-admin.netlify.app

# Live streaming (LiveKit Cloud free tier: livekit.io)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Calls ring a closed iPhone through Apple VoIP pushes (APNs key from the Apple Developer account).
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.ramjankhan.greenifyx
APNS_PRODUCTION=false
# Public API address the phone uses to decline a call from the lock screen.
PUBLIC_API_URL=https://greenifyx.onrender.com/api
