PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated browser origins. Native mobile clients send no Origin.
CORS_ORIGIN=

# Resend email OTP (use a from-address on a domain you verified in Resend)
RESEND_API_KEY=
EMAIL_FROM=
APP_NAME=GreenifyX

# Non-production only. When true, send-otp may include devOtp in the JSON body.
# Ignored when NODE_ENV=production.
ALLOW_DEV_OTP=false
